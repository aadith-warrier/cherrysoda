+model_config: "configs/model/dream_7b.yaml"
+dataset_config: "configs/dataset/proofwriter_depth3.yaml"
+sample_size: 300            # 0-149 design half, 150-299 held out; 50 per label in each
+seed: 42
+
+# Drafts use the Table 2 baseline decoding (vanilla_proofwriter_d3_dream), so the draft accuracy is the baseline.

--- /dev/null
+++ b/run_answer_check.sh
@@ -0,0 +1,111 @@
+#!/usr/bin/env bash
+# Answer-support check + label ban on ProofWriter, LLaDA and Dream, 300 questions each
+# (0-149 design half, 150-299 held out).
+#
+#   bash run_answer_check.sh            # GPU cuda:0
+#   bash run_answer_check.sh cuda:1
+#
+# Everything printed also goes to logs/run_answer_check.log. When it finishes, send
+#   results/answer_check_report.md
+# Per-problem progress for each run is in logs/<run_id>.stdout.log. Safe to re-run: finished problems are skipped.
+set -uo pipefail
+cd "$(dirname "$0")"
+export PYTHONNOUSERSITE=1
+DEVICE="${1:-cuda:0}"
+mkdir -p logs results
+exec > >(tee -a logs/run_answer_check.log) 2>&1
+
+say() { echo; echo "=== $(date '+%F %T')  $*"; }
+die() { echo; echo "STOPPED: $*"; echo "Send logs/run_answer_check.log"; exit 1; }
+PY="pixi run python"
+
+say "repo $(git rev-parse --short HEAD 2>/dev/null)  device $DEVICE"
+nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader 2>/dev/null || true
+
+# ---------------------------------------------------------------- 1. unit tests (fake models, no GPU)
+say "1/5 unit tests"
+$PY -m pytest -q tests/test_graph_remask_proofwriter.py tests/test_graph_logic.py tests/test_graph_remask.py \
+    || die "unit tests failed"
+
+# ---------------------------------------------------------------- 2. label tokens with the real tokenizers
+say "2/5 label tokens the ban will forbid"
+$PY - <<'EOF' || die "label token check failed"
+import sys, yaml
+sys.path.insert(0, ".")
+from transformers import AutoTokenizer
+from src.methods.graph_remask import label_token_ids
+ok = True
+for cfg in ("configs/model/llada_8b.yaml", "configs/model/dream_7b.yaml"):
+    repo = yaml.safe_load(open(cfg))["hf_repo_id"]
+    tok = AutoTokenizer.from_pretrained(repo, trust_remote_code=True)
+    for lab in ("True", "False", "Unknown"):
+        ids = label_token_ids(tok, lab)
+        pieces = [tok.decode([i]) for i in ids]
+        good = bool(ids) and all(lab.lower().startswith(p.strip().lstrip(':*"').lower()) and p.strip().lstrip(':*"')
+                                 for p in pieces)
+        ok &= good
+        print(f"  {repo:32} {lab:8} -> {pieces}  {'ok' if good else 'UNEXPECTED'}")
+sys.exit(0 if ok else 1)
+EOF
+
+# ---------------------------------------------------------------- 3. smoke: do bans change labels?
+say "3/5 smoke run: 20 LLaDA problems with the ban (cached drafts)"
+$PY -m scripts.run_graph_method --config configs/run/graph_ans_proofwriter_d3_llada_n300.yaml --limit 20 \
+    --device "$DEVICE" > logs/smoke_answer_check.stdout.log 2>&1 || { tail -30 logs/smoke_answer_check.stdout.log; die "smoke run crashed"; }
+$PY - <<'EOF' || die "bans did not change any label: the ban is not reaching the model"
+import json, sys
+rs = [json.loads(l) for l in open("logs/graph_ans_proofwriter_d3_llada_n300_limit20/generations.jsonl")]
+banned = [r for r in rs if any(x.get("banned_labels") for x in r["rounds"])]
+changed = [r for r in banned if r["draft_predicted"] != r["predicted_answer"]]
+print(f"  {len(rs)} problems, {len(banned)} answer lines banned, label changed in {len(changed)}")
+for r in banned:
+    print(f"    {r['example_id']}  ref {r['reference_answer']:7}  draft {r['draft_predicted']} -> {r['predicted_answer']}"
+          f"  banned {[x.get('banned_labels') for x in r['rounds']]}")
+sys.exit(1 if banned and not changed else 0)
+EOF
+
+# ---------------------------------------------------------------- 4. the six runs
+run() {   # run_id
+  local rid="$1"
+  say "run $rid"
+  $PY -m scripts.run_graph_method --config "configs/run/${rid}.yaml" --device "$DEVICE" 2>&1 \
+    | tee -a "logs/${rid}.stdout.log" \
+    | awk '/^\[[^]]*\] [0-9]+\/[0-9]+ /{split($2,a,"/"); if (a[1]%25==0 || a[1]==a[2]) print; next} {print}' \
+    || echo "!!! $rid FAILED (see logs/${rid}.stdout.log); continuing"
+}
+say "4/5 runs (graph_remask first: it decodes the 150 new drafts, the other two reuse them)"
+for m in llada dream; do
+  run "graph_remask_proofwriter_d3_${m}_n300"
+  run "graph_ans_noban_proofwriter_d3_${m}_n300"
+  run "graph_ans_proofwriter_d3_${m}_n300"
+done
+
+# ---------------------------------------------------------------- 5. reports
+say "5/5 reports"
+REPORT=results/answer_check_report.md
+{
+  echo "# Answer-support check + label ban, ProofWriter depth 3, n = 300 ($(date '+%F %T'))"
+  echo "repo $(git rev-parse --short HEAD 2>/dev/null)"
+  for m in llada dream; do
+    echo; echo "## ${m}: design half vs held-out half"
+    $PY -m scripts.split_report --names graph graph+check graph+check+ban \
+      --runs logs/graph_remask_proofwriter_d3_${m}_n300 logs/graph_ans_noban_proofwriter_d3_${m}_n300 \
+             logs/graph_ans_proofwriter_d3_${m}_n300 \
+      --out results/answer_check_split_${m}.md 2>&1 | grep -v '^wrote'
+    echo; echo "## ${m}: all 300"
+    $PY -m scripts.compare_methods --names graph graph+check graph+check+ban \
+      --runs logs/graph_remask_proofwriter_d3_${m}_n300 logs/graph_ans_noban_proofwriter_d3_${m}_n300 \
+             logs/graph_ans_proofwriter_d3_${m}_n300 \
+      --out results/answer_check_all_${m} 2>&1 | grep -v '^wrote'
+    echo; echo "## ${m}: error breakdown, graph+check+ban"
+    echo '```'
+    $PY -m scripts.analyze_proofwriter_remask logs/graph_ans_proofwriter_d3_${m}_n300 2>&1
+    echo '```'
+    for v in graph_remask graph_ans_noban graph_ans; do
+      echo; echo "## ${m}: ${v} summary"; echo
+      cat "logs/${v}_proofwriter_d3_${m}_n300/summary.md" 2>/dev/null || echo "(missing)"
+    done
+  done
+} > "$REPORT" 2>&1
+cat "$REPORT"
+say "done. Send $REPORT"
diff --git a/scripts/split_report.py b/scripts/split_report.py
new file mode 100644
index 0000000..3e73fa1
--- /dev/null
+++ b/scripts/split_report.py
@@ -0,0 +1,101 @@
+"""Results of remask runs on the design half (first 150 ProofWriter questions, where the answer-support idea came
+from) and the held-out half (questions 150-299, fresh drafts), reported separately.
+
+    python -m scripts.split_report --runs logs/A logs/B ... [--names a b ...] [--split 150] [--out results/x.md]
+
+Per run and half: draft and final accuracy, paired bootstrap 95% CI of the change, fixed / broken, exact McNemar p,
+and for runs with the answer check how many answer lines were rejected and how often the label then changed.
+Then every pair of runs head to head on each half (same drafts, so the comparison is paired).
+"""
+import argparse
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from scripts.compare_runs import mcnemar_exact_p  # noqa: E402
+from scripts.run_graph_method import paired_bootstrap_ci  # noqa: E402
+
+
+def load(run_dir):
+    with open(os.path.join(run_dir, "generations.jsonl")) as f:
+        rs = [json.loads(line) for line in f]
+    return {r["example_id"]: r for r in rs}
+
+
+def final_pred(r):
+    return r.get("predicted_answer", r.get("predicted"))
+
+
+def halves(ids, split):
+    ids = sorted(ids)
+    return {"design": ids[:split], "held-out": ids[split:]}
+
+
+def row(rs, ids):
+    d = [bool(rs[i]["draft_correct"]) for i in ids]
+    f = [bool(rs[i]["correct"]) for i in ids]
+    fixed = sum(1 for a, b in zip(d, f) if not a and b)
+    broken = sum(1 for a, b in zip(d, f) if a and not b)
+    lo, hi = paired_bootstrap_ci(d, f)
+    banned = [rs[i] for i in ids if any(x.get("banned_labels") for x in rs[i].get("rounds") or [])]
+    changed = sum(1 for r in banned if r["draft_predicted"] != final_pred(r))
+    return {"n": len(ids), "draft": sum(d) / len(ids), "final": sum(f) / len(ids), "lo": lo, "hi": hi,
+            "fixed": fixed, "broken": broken, "p": mcnemar_exact_p(fixed, broken),
+            "banned": len(banned), "banned_changed": changed,
+            "banned_fixed": sum(1 for r in banned if not r["draft_correct"] and r["correct"]),
+            "banned_broken": sum(1 for r in banned if r["draft_correct"] and not r["correct"])}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--runs", nargs="+", required=True)
+    ap.add_argument("--names", nargs="+")
+    ap.add_argument("--split", type=int, default=150, help="first N questions are the design half")
+    ap.add_argument("--out", help="also write the tables to this .md file")
+    args = ap.parse_args()
+    names = args.names or [os.path.basename(r.rstrip("/")) for r in args.runs]
+    runs = {}
+    for name, d in zip(names, args.runs):
+        if not os.path.exists(os.path.join(d, "generations.jsonl")):
+            print(f"(skipping {name}: {d} has no generations.jsonl)")
+            continue
+        runs[name] = load(d)
+    if not runs:
+        sys.exit("no runs found")
+    common = set.intersection(*(set(r) for r in runs.values()))
+    parts = halves(common, args.split)
+    lines = []
+    for half, ids in parts.items():
+        if not ids:
+            continue
+        lines += [f"\n### {half} ({ids[0]} .. {ids[-1]}, n = {len(ids)})\n",
+                  "| method | draft | final | Δ [95% CI] | fixed / broken | McNemar p | answer bans: lines / label changed / fixed / broken |",
+                  "|---|---|---|---|---|---|---|"]
+        for name, rs in runs.items():
+            s = row(rs, ids)
+            bans = (f"{s['banned']} / {s['banned_changed']} / {s['banned_fixed']} / {s['banned_broken']}"
+                    if s["banned"] else "-")
+            lines.append(f"| {name} | {100 * s['draft']:.1f}% | {100 * s['final']:.1f}% | "
+                         f"{100 * (s['final'] - s['draft']):+.1f} [{100 * s['lo']:+.1f}, {100 * s['hi']:+.1f}] | "
+                         f"{s['fixed']} / {s['broken']} | {s['p']:.3f} | {bans} |")
+        names_ = list(runs)
+        if len(names_) > 1:
+            lines += ["", "| A vs B | A only right | B only right | gap A-B | McNemar p |", "|---|---|---|---|---|"]
+            for i, a in enumerate(names_):
+                for b in names_[i + 1:]:
+                    ao = sum(1 for k in ids if runs[a][k]["correct"] and not runs[b][k]["correct"])
+                    bo = sum(1 for k in ids if runs[b][k]["correct"] and not runs[a][k]["correct"])
+                    lines.append(f"| {a} vs {b} | {ao} | {bo} | {100 * (ao - bo) / len(ids):+.1f} | {mcnemar_exact_p(ao, bo):.3f} |")
+    text = "\n".join(lines)
+    print(text)
+    if args.out:
+        os.makedirs(os.path.dirname(args.out) or ".", exist_ok=True)
+        with open(args.out, "w") as f:
+            f.write(text + "\n")
+        print(f"\nwrote {args.out}")
+
+
+if __name__ == "__main__":
+    main()

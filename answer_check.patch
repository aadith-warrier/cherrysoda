+  max_new_tokens: 256
+  num_denoising_steps: 256
+  block_length: null
+verifier:
+  name: graph_logic
+  skip_kinds: [meta]        # lines that only restate the hypothesis: 15% of the logic verifier's LLaDA flags, all spurious
+  check_answer: true        # flag answer lines whose label contradicts the verified steps
+
+remask:
+  mode: graph
+  max_rounds: 3
+  steps_per_round: null
+  temperature: null
+  confidence_eos_eot_inf: true
+
+draft_cache: "logs/draft_cache"
